# Copy this file to .env.local and fill in your Google OAuth client ID
# Vite uses VITE_ prefix for client-side environment variables
VITE_GOOGLE_CLIENT_ID=you-google-client-id

# Optional: override API base URL for local development
VITE_API_BASE_URL=http://localhost:5000

# Optional: Google AdSense publisher ID. Use your real ca-pub value after approval/setup.
# Example format: ca-pub-1234567890123456
VITE_GOOGLE_ADSENSE_CLIENT=
