# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/myconvertertool 
#||mongodb+srv://user_name: password @dbname.e0ucmme.mongodb.net/

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRY=7d

# Google Identity Services Configuration
GOOGLE_CLIENT_ID=your-google-client-id
# No client secret needed for GIS flow

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password
EMAIL_FROM_NAME=MyConverterTool
EMAIL_FROM_ADDRESS=noreply@myconvertertool.com

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Initial Admin Configuration
INITIAL_ADMIN_NAME="Super Admin"
INITIAL_ADMIN_EMAIL=admin@myconvertertool.com
INITIAL_ADMIN_PASSWORD=your-secure-admin-password
# AI blog writer (disabled until configured and deliberately authorized)
# Keep the actual key server-only; choose an available JSON-capable Gemini model.
GEMINI_API_KEY=
GEMINI_WRITER_MODEL=
GEMINI_WRITER_BILLING_MODE=free
AI_WRITER_ALLOW_REQUESTS=false
GEMINI_WRITER_MAX_MONTHLY_REQUESTS=90

# Optional: external master key for encrypted admin-managed Gemini credentials.
# Leave blank to create a private key file under the service user's home directory.
GEMINI_WRITER_ENCRYPTION_KEY=
GEMINI_WRITER_SECRET_KEY_FILE=
