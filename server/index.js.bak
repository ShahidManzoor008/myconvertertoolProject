const app = express();
const port = process.env.PORT || 5000;
// const allowedOrigins =["http://localhost:3000"];
const allowedOrigins = process.env.CORS_ORIGIN ? process.env.CORS_ORIGIN.split(",") : ["http://localhost:3000"];
