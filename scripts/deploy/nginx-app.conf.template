# Included inside each application server {} block, after TLS/listen settings.
# Nginx reads the absolute release root on reload; old workers retain their root.
root @@RELEASE_ROOT@@/client/dist;
index index.html;
client_max_body_size 100M;

location /assets/ {
    try_files $uri @retained_assets;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
}
location @retained_assets {
    root @@SHARED_ROOT@@;
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
}
location /fonts/ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
}
location = /site.webmanifest { default_type application/manifest+json; try_files $uri =404; }
location = /app.html { return 404; }
location = /index.html { add_header Cache-Control "no-cache" always; }
location ~ /\.(?!well-known) { return 404; }
location ~* \.(?:php|asp|aspx|jsp|cgi|pl)$ { return 404; }
location /api/ {
    proxy_pass http://127.0.0.1:@@PORT@@;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 180s;
}
location = /blog { try_files /nonexistent @frontend; }
location /blog/ { try_files /nonexistent @frontend; }
location = /sitemap.xml { try_files /nonexistent @frontend; }
location / { try_files $uri/index.html $uri @frontend; add_header Cache-Control "no-cache" always; }
location @frontend {
    proxy_pass http://127.0.0.1:@@PORT@@;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 180s;
}
